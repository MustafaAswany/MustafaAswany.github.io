  "steps": [
    {
      "en": {
        "t": "The brief",
        "d": "Understand the message, the audience, and where the piece will play: feed, stage screen or inbox."
      },
      "ar": {
        "t": "البريف",
        "d": "أفهم الرسالة والجمهور، والمكان اللي هيتعرض فيه الشغل: فيد، شاشة مسرح، أو إيميل."
      }
    },
    {
      "en": {
        "t": "Script & storyboard",
        "d": "Lock the story and timing before the first keyframe, so revisions stay small."
      },
      "ar": {
        "t": "السكريبت والستوري بورد",
        "d": "أقفل القصة والتوقيت قبل أول كي فريم، عشان التعديلات تبقى بسيطة."
      }
    },
    {
      "en": {
        "t": "Styleframes",
        "d": "Design key frames in the brand's type, colour and tone, and agree on the look."
      },
      "ar": {
        "t": "الستايل فريمز",
        "d": "أصمم الفريمات الأساسية بخطوط وألوان وروح البراند، ونتفق على الشكل."
      }
    },
    {
      "en": {
        "t": "Animate & edit",
        "d": "Build the motion in After Effects, cut to voiceover and music in Premiere, refine the rhythm."
      },
      "ar": {
        "t": "التحريك والمونتاج",
        "d": "أبني الموشن على After Effects، وأقطع على الفويس أوفر والمزيكا في Premiere، وأظبط الإيقاع."
      }
    },
    {
      "en": {
        "t": "Sound & delivery",
        "d": "Clean the audio, grade, and export every size the platforms need."
      },
      "ar": {
        "t": "الصوت والتسليم",
        "d": "أنضف الصوت وأعمل الجريد، وأطلّع كل المقاسات اللي المنصات محتاجاها."
      }
    }
  ],
